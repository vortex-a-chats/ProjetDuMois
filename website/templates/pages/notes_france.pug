extends ../layout.pug

block head
	script(src="/lib/chart.js/chart.min.js")
	script(src="/lib/chartjs-adapter-date-fns/chartjs-adapter-date-fns.bundle.min.js")

block navbar
	a(href="/#others")
		i.fa.fa-file-download(title=__("Les projets"))
		span= __("Les projets")
	a(href="/osm-plein-air")
		i.fa.fa-mountain(title=__("OSM Plein Air"))
		span= __("OSM Plein Air")
	a(href="/notes-france")
		i.fa.fa-sticky-note(title=__("Notes OSM"))
		span= __("Notes OSM")
	a(href="/about")
		i.fa.fa-flag(title=__("À propos"))
		span= __("À propos")

block content
	div.container
		div.jumbotron.py-2.px-3.pb-3.p-md-5.mb-3.text-white.rounded.bg-dark
			h1.font-italic= __("Surveillance des notes OSM en France")
			p.lead.mb-0= __("Évolution quotidienne du nombre de notes ouvertes et fermées")

	// Graphique des notes créées (30 derniers jours) - EN PREMIER
	div.container-fluid.py-5.pdm-section-highlight
		div.container
			div.row
				div.col-12.mb-4
					h2.mb-3= __("Notes créées (30 derniers jours)")
					div(style="position: relative;")
						div.spinner-created-charts.spinner-border.text-primary(role="status" style="width: 64px; height: 64px")
						canvas#notes-created-chart.w-100(height="300")
					p.small.text-muted.mt-2
						i.fa.fa-info-circle.mr-1
						= __("Nombre de nouvelles notes créées chaque jour au cours des 30 derniers jours.")
	
	// Graphique des notes fermées (30 derniers jours)
	div.container-fluid.py-5
		div.container
			div.row
				div.col-12.mb-4
					h2.mb-3= __("Notes fermées (30 derniers jours)")
					div(style="position: relative;")
						div.spinner-closed-charts.spinner-border.text-primary(role="status" style="width: 64px; height: 64px")
						canvas#notes-closed-chart.w-100(height="300")
					p.small.text-muted.mt-2
						i.fa.fa-info-circle.mr-1
						= __("Nombre de notes fermées chaque jour au cours des 30 derniers jours.")

	// Tableau des notes les plus récentes
	if recentNotes && recentNotes.length > 0
		div.container-fluid.py-5.pdm-section-highlight
			div.container
				div.row
					div.col-12
						h2.mb-3= __("Notes les plus récentes (nouvelles et résolues)")
						p.text-muted.small.mb-3= __("Affichage des 50 notes les plus récentes en France, triées par date de dernière activité.")
						div.table-responsive
							table.table.table-striped.table-hover
								thead.thead-dark
									tr
										th= __("ID")
										th= __("Statut")
										th= __("Contenu")
										th= __("Date de création")
										th= __("Date de fermeture")
										th= __("Dernière activité")
										th= __("Actions")
								tbody
									each note in recentNotes
										tr
											td
												strong= note.id
											td
												if note.status === 'open'
													span.badge.badge-warning= __("Ouverte")
												else
													span.badge.badge-success= __("Fermée")
											td
												if note.comment
													span(style="max-width: 400px; display: inline-block;")= note.comment.substring(0, 150) + (note.comment.length > 150 ? '...' : '')
												else
													span.text-muted= __("Aucun commentaire")
											td
												small= new Date(note.date_created).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })
											td
												if note.date_closed
													small= new Date(note.date_closed).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })
												else
													span.text-muted= __("-")
											td
												small
													if note.date_closed
														= new Date(note.date_closed).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })
													else if note.last_comment_date
														= new Date(note.last_comment_date).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })
													else
														= new Date(note.date_created).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })
											td
												a.btn.btn-sm.btn-primary(href=note.url target="_blank" rel="noopener noreferrer" title=__("Voir la note sur OSM"))
													i.fa.fa-external-link-alt.mr-1
													= __("Voir")
												span.ml-2
													a.btn.btn-sm.btn-outline-secondary(href=`https://www.openstreetmap.org/?mlat=${note.lat}&mlon=${note.lon}&zoom=18&layers=N` target="_blank" rel="noopener noreferrer" title=__("Voir sur la carte"))
														i.fa.fa-map-marker-alt

	// Graphique d'évolution des notes (existant)
	div.container-fluid.py-5.pdm-section-highlight
		div.container
			div.row
				div.col-12.mb-4
					div.d-flex.justify-content-between.align-items-center.mb-3
						h2.mb-0= __("Évolution des notes")
						div.form-group.mb-0
							label.sr-only(for="boundary-select")= __("Sélectionner des zones")
							select#boundary-select.form-control.form-control-sm(multiple style="min-width: 300px; max-height: 100px;")
								option(value="")= __("Chargement des zones...")
					div(style="position: relative;")
						div.spinner-charts.spinner-border.text-primary(role="status" style="width: 64px; height: 64px")
						canvas#notes-chart.w-100(height="400")
						a(href="https://www.openstreetmap.org" target="_blank" style="position: absolute; bottom: 50px; left: 10px; z-index: 1000; opacity: 0.8; pointer-events: auto;")
							img(src="https://wiki.openstreetmap.org/w/images/7/79/Public-images-osm_logo.svg" alt="OpenStreetMap" style="height: 30px;")
					p.small.text-muted.mt-2
						i.fa.fa-info-circle.mr-1
						= __("Sélectionnez une ou plusieurs zones pour voir leur évolution. Par défaut, le graphique affiche les données globales de la France.")

	script.
		const chartData = !{JSON.stringify(chartData)};
		let myChart = null;
		let createdChart = null;
		let closedChart = null;
		const numberFormat = new Intl.NumberFormat('fr-FR');
		
		// Fonction pour filtrer les 30 derniers jours
		function getLast30DaysData(data, field) {
			return data
				.filter(d => {
					const date = new Date(d.t);
					const thirtyDaysAgo = new Date();
					thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
					return date >= thirtyDaysAgo;
				})
				.map(d => ({ t: d.t, y: d[field] || 0 }));
		}
		
		// Initialiser le graphique des notes créées (30 derniers jours)
		function initCreatedChart() {
			const ctx = document.getElementById("notes-created-chart");
			if (!ctx) return;
			
			const spinner = document.querySelector(".spinner-created-charts");
			if (!chartData || chartData.length === 0) {
				if (spinner) spinner.classList.add("d-none");
				ctx.parentElement.innerHTML = '<p class="text-muted">Aucune donnée disponible</p>';
				return;
			}
			
			const createdData = getLast30DaysData(chartData, 'created');
			
			if (spinner) spinner.classList.add("d-none");
			
			if (createdChart) {
				createdChart.destroy();
			}
			
			createdChart = new Chart(ctx.getContext("2d"), {
				type: "bar",
				data: {
					datasets: [{
						label: "#{__('Notes créées')}",
						data: createdData,
						backgroundColor: "rgba(33, 150, 243, 0.6)",
						borderColor: "#2196F3",
						borderWidth: 1
					}]
				},
				options: {
					responsive: true,
					scales: {
						xAxes: [{
							type: 'time',
							time: {
								tooltipFormat: "DD/MM/YYYY",
								displayFormats: { day: "DD/MM/YYYY" }
							}
						}],
						yAxes: [{
							ticks: {
								beginAtZero: true,
								callback: function(value) {
									return numberFormat.format(value);
								}
							}
						}]
					},
					legend: {
						display: true,
						position: 'bottom'
					},
					tooltips: {
						callbacks: {
							label: function(tooltipItem) {
								return "#{__('Notes créées')}: " + numberFormat.format(tooltipItem.yLabel);
							}
						}
					}
				}
			});
		}
		
		// Initialiser le graphique des notes fermées (30 derniers jours)
		function initClosedChart() {
			const ctx = document.getElementById("notes-closed-chart");
			if (!ctx) return;
			
			const spinner = document.querySelector(".spinner-closed-charts");
			if (!chartData || chartData.length === 0) {
				if (spinner) spinner.classList.add("d-none");
				ctx.parentElement.innerHTML = '<p class="text-muted">Aucune donnée disponible</p>';
				return;
			}
			
			const closedData = getLast30DaysData(chartData, 'closed_daily');
			
			if (spinner) spinner.classList.add("d-none");
			
			if (closedChart) {
				closedChart.destroy();
			}
			
			closedChart = new Chart(ctx.getContext("2d"), {
				type: "bar",
				data: {
					datasets: [{
						label: "#{__('Notes fermées')}",
						data: closedData,
						backgroundColor: "rgba(76, 175, 80, 0.6)",
						borderColor: "#4CAF50",
						borderWidth: 1
					}]
				},
				options: {
					responsive: true,
					scales: {
						xAxes: [{
							type: 'time',
							time: {
								tooltipFormat: "DD/MM/YYYY",
								displayFormats: { day: "DD/MM/YYYY" }
							}
						}],
						yAxes: [{
							ticks: {
								beginAtZero: true,
								callback: function(value) {
									return numberFormat.format(value);
								}
							}
						}]
					},
					legend: {
						display: true,
						position: 'bottom'
					},
					tooltips: {
						callbacks: {
							label: function(tooltipItem) {
								return "#{__('Notes fermées')}: " + numberFormat.format(tooltipItem.yLabel);
							}
						}
					}
				}
			});
		}
		
		// Initialiser les graphiques au chargement
		function initCharts() {
			initCreatedChart();
			initClosedChart();
		}
		
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initCharts);
		} else {
			initCharts();
		}
		
		// Couleurs pour les différentes zones
		const colors = [
			{ border: "#F44336", fill: "rgba(244, 67, 54, 0.2)" },
			{ border: "#4CAF50", fill: "rgba(76, 175, 80, 0.2)" },
			{ border: "#2196F3", fill: "rgba(33, 150, 243, 0.2)" },
			{ border: "#FF9800", fill: "rgba(255, 152, 0, 0.2)" },
			{ border: "#9C27B0", fill: "rgba(156, 39, 176, 0.2)" },
			{ border: "#00BCD4", fill: "rgba(0, 188, 212, 0.2)" },
			{ border: "#795548", fill: "rgba(121, 85, 72, 0.2)" },
			{ border: "#607D8B", fill: "rgba(96, 125, 139, 0.2)" }
		];
		
		function updateChart(data, boundaries = null) {
			const ctx = document.getElementById("notes-chart").getContext("2d");
			const spinner = document.querySelector(".spinner-charts");
			
			if (!data || data.length === 0) {
				if (spinner) spinner.classList.add("d-none");
				document.getElementById("notes-chart").parentElement.innerHTML = '<p class="text-muted">Aucune donnée disponible</p>';
				return;
			}
			
			if (spinner) spinner.classList.add("d-none");
			
			let datasets = [];
			
			if (boundaries && boundaries.length > 0) {
				// Afficher les données par zone
				boundaries.forEach((boundary, index) => {
					const color = colors[index % colors.length];
					datasets.push({
						label: boundary.name + " - " + "#{__('Notes ouvertes')}",
						data: boundary.data.map(d => ({ t: d.t, y: d.open })),
						fill: true,
						borderColor: color.border,
						backgroundColor: color.fill,
						lineTension: 0
					});
					datasets.push({
						label: boundary.name + " - " + "#{__('Notes fermées')}",
						data: boundary.data.map(d => ({ t: d.t, y: d.closed })),
						fill: true,
						borderColor: color.border,
						backgroundColor: color.fill,
						lineTension: 0,
						borderDash: [5, 5]
					});
				});
			} else {
				// Afficher les données globales
				datasets = [
					{
						label: "#{__('Notes ouvertes')}",
						data: data.map(d => ({ t: d.t, y: d.open })),
						fill: true,
						borderColor: "#F44336",
						backgroundColor: "rgba(244, 67, 54, 0.2)",
						lineTension: 0
					},
					{
						label: "#{__('Notes fermées')}",
						data: data.map(d => ({ t: d.t, y: d.closed })),
						fill: true,
						borderColor: "#4CAF50",
						backgroundColor: "rgba(76, 175, 80, 0.2)",
						lineTension: 0
					},
					{
						label: "#{__('Total')}",
						data: data.map(d => ({ t: d.t, y: d.total })),
						fill: false,
						borderColor: "#2196F3",
						lineTension: 0
					}
				];
			}
			
			if (myChart) {
				myChart.destroy();
			}
			
			myChart = new Chart(ctx, {
				type: "line",
				data: { datasets: datasets },
				options: {
					responsive: true,
					scales: {
						xAxes: [{
							type: 'time',
							time: {
								tooltipFormat: "DD/MM/YYYY",
								displayFormats: { day: "DD/MM/YYYY", month: "MM/YYYY" }
							}
						}],
						yAxes: [{
							ticks: {
								beginAtZero: true,
								callback: function(value) {
									return numberFormat.format(value);
								}
							}
						}]
					},
					legend: {
						display: true,
						position: 'bottom'
					}
				}
			});
		}
		
		// Initialiser le graphique avec les données globales
		if(chartData && chartData.length > 0) {
			updateChart(chartData);
		} else {
			document.querySelector(".spinner-charts").classList.add("d-none");
			document.getElementById("notes-chart").parentElement.innerHTML = '<p class="text-muted">Aucune donnée disponible</p>';
		}
		
		// Charger la liste des zones disponibles
		const boundarySelect = document.getElementById("boundary-select");
		fetch('/api/notes-france/boundaries/list')
			.then(res => res.json())
			.then(data => {
				boundarySelect.innerHTML = '<option value="">' + "#{__('Toutes les zones (données globales)')}" + '</option>';
				if (data.boundaries && data.boundaries.length > 0) {
					data.boundaries.forEach(boundary => {
						const option = document.createElement('option');
						option.value = boundary.boundary;
						option.textContent = boundary.name + ' (niveau ' + boundary.admin_level + ')';
						option.dataset.adminLevel = boundary.admin_level;
						boundarySelect.appendChild(option);
					});
				}
			})
			.catch(err => {
				console.error('Error loading boundaries:', err);
				boundarySelect.innerHTML = '<option value="">' + "#{__('Erreur lors du chargement des zones')}" + '</option>';
			});
		
		// Gérer la sélection de zones
		boundarySelect.addEventListener('change', function() {
			const selectedBoundaries = Array.from(this.selectedOptions)
				.map(opt => opt.value)
				.filter(val => val !== '');
			
			if (selectedBoundaries.length === 0) {
				// Afficher les données globales
				updateChart(chartData);
			} else {
				// Charger les données pour les zones sélectionnées
				const spinner = document.querySelector(".spinner-charts");
				if (spinner) {
					spinner.classList.remove("d-none");
				}
				
				fetch('/api/notes-france/boundaries?boundaries=' + selectedBoundaries.join(','))
					.then(res => res.json())
					.then(data => {
						if (data.boundaries && data.boundaries.length > 0) {
							updateChart(null, data.boundaries);
						} else {
							updateChart([]);
						}
					})
					.catch(err => {
						console.error('Error loading boundary data:', err);
						updateChart([]);
					});
			}
		});

	div.container-fluid.py-5
		div.container
			div.row
				div.col-12
					div.card.mt-4
						div.card-header
							h5.card-title.mb-0= __("API JSON")
						div.card-body
							p= __("Vous pouvez obtenir les données de cette page au format JSON via l'API suivante :")
							pre.code-block
								code GET http://localhost:3000/api/notes-france
							p.small.text-muted.mt-2= __("Cette API retourne un tableau d'objets avec les champs suivants :")
							ul.small
								li
									code t
									= __(" : Date de la mesure (format ISO)")
								li
									code open
									= __(" : Nombre de notes ouvertes")
								li
									code closed
									= __(" : Nombre de notes fermées")
								li
									code total
									= __(" : Nombre total de notes (ouvertes + fermées)")

