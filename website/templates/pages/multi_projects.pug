					const contribPodium = document.getElementById("podium-contributions");
					const contribSpinner = contribPodium.querySelector(".spinner-border");
					if(contribSpinner) contribSpinner.remove();
					contribPodium.innerHTML = '';
					
					if(data.contributions && data.contributions.length > 0) {
						const positions = [2, 1, 3]; // Middle, left, right
						const heights = [200, 150, 120]; // Gold, silver, bronze
						const colors = ['#FFD700', '#C0C0C0', '#CD7F32']; // Gold, silver, bronze
						const medals = ['🥇', '🥈', '🥉'];
						const minHeight = 120; // Hauteur minimum pour toutes les barres
						
						data.contributions.forEach((proj, index) => {
							const pos = positions[index];
							const height = Math.max(heights[index], minHeight);
							const color = colors[index];
							const medal = medals[index];
							
							const div = document.createElement("div");
							div.classList.add("col-md-4", "text-center", "d-flex", "flex-column");
							div.style.order = pos;
							div.style.justifyContent = "flex-end";
							
							const objetsText = "#{__('objets')}";
							div.innerHTML = 
								'<div style="min-height: ' + minHeight + 'px; height: ' + height + 'px; background: linear-gradient(to top, ' + color + ', ' + color + '88); border-radius: 10px 10px 0 0; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; padding: 10px; margin-bottom: 10px;">' +
