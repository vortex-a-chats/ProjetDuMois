extends ../layout.pug

block head
	script(src="/lib/chart.js/chart.min.js")
	script(src="/lib/chartjs-adapter-date-fns/chartjs-adapter-date-fns.bundle.min.js")
	script(src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1/dist/chartjs-plugin-zoom.min.js")

block navbar
	a(href="#others")
		i.fa.fa-file-download(title=__("Les projets"))
		span= __("Les projets")
	a(href="/osm-plein-air")
		i.fa.fa-mountain(title=__("OSM Plein Air"))
		span= __("OSM Plein Air")
	a(href="/notes-france")
		i.fa.fa-sticky-note(title=__("Notes OSM"))
		span= __("Notes OSM")
	a(href="/about")
		i.fa.fa-flag(title=__("À propos"))
		span= __("À propos")


block content
	//- Global progress chart and podiums
	div.container-fluid.py-5.mb-3.pdm-section-highlight
		div.container
			div.row.mb-4
				div.col-12
					h2.blog-post-title.mb-3
						i.fa.fa-chart-line.mr-2(style="font-size: 2.1rem")
						= __("Vue d'ensemble")
					
					//- Global progress chart
					div.row.mb-4
						div.col-12
							div.d-flex.justify-content-between.align-items-center.mb-2
								h3.mb-0= __("Progression de tous les projets")
								div.btn-group(role="group")
									button.btn.btn-sm.btn-outline-secondary#chart-reset-zoom(type="button" style="display: none;")
										i.fa.fa-home.mr-1
										= __("Réinitialiser zoom")
									button.btn.btn-sm.btn-outline-primary#chart-export(type="button")
										i.fa.fa-download.mr-1
										= __("Exporter")
							div(style="position: relative;")
								div.spinner-charts.spinner-border.text-primary(role="status" style="width: 64px; height: 64px")
								canvas#all-projects-chart.w-100(height="400")
								a(href="https://www.openstreetmap.org" target="_blank" style="position: absolute; bottom: 50px; left: 10px; z-index: 1000; opacity: 0.8; pointer-events: auto;")
									img(src="https://wiki.openstreetmap.org/w/images/7/79/Public-images-osm_logo.svg" alt="OpenStreetMap" style="height: 30px;")
					
					//- Cumulative progress chart
					div.row.mb-4
						div.col-12
							div.d-flex.justify-content-between.align-items-center.mb-2
								h3.mb-0= __("Cumul de toutes les mesures")
							div(style="position: relative;")
								div.spinner-charts-cumulative.spinner-border.text-primary(role="status" style="width: 64px; height: 64px")
								canvas#cumulative-chart.w-100(height="400")
								a(href="https://www.openstreetmap.org" target="_blank" style="position: absolute; bottom: 50px; left: 10px; z-index: 1000; opacity: 0.8; pointer-events: auto;")
									img(src="https://wiki.openstreetmap.org/w/images/7/79/Public-images-osm_logo.svg" alt="OpenStreetMap" style="height: 30px;")
					
					//- Active users chart
					div.row.mb-4
						div.col-12
							div.d-flex.justify-content-between.align-items-center.mb-2
								h3.mb-0= __("Contributeurs actifs")
							div(style="position: relative;")
								div.spinner-charts-users.spinner-border.text-primary(role="status" style="width: 64px; height: 64px")
								canvas#active-users-chart.w-100(height="400")
								a(href="https://www.openstreetmap.org" target="_blank" style="position: absolute; bottom: 50px; left: 10px; z-index: 1000; opacity: 0.8; pointer-events: auto;")
									img(src="https://wiki.openstreetmap.org/w/images/7/79/Public-images-osm_logo.svg" alt="OpenStreetMap" style="height: 30px;")
					
					//- Podiums
					div.row
						div.col-md-6.mb-4
							h3
								= __("Top 3 contributions (30 jours)")
								button.btn.btn-sm.btn-link.ml-2(type="button" data-toggle="modal" data-target="#podium-contributions-modal" style="padding: 0; vertical-align: baseline;")
									i.fa.fa-info-circle
							div#podium-contributions.row.justify-content-center.align-items-end(style="min-height: 450px;")
								div.col.text-center
									div.spinner-border.text-primary(role="status")
						
						div.col-md-6.mb-4
							h3
								= __("Top 3 qualité (30 jours)")
								button.btn.btn-sm.btn-link.ml-2(type="button" data-toggle="modal" data-target="#podium-quality-modal" style="padding: 0; vertical-align: baseline;")
									i.fa.fa-info-circle
							div#podium-quality.row.justify-content-center.align-items-end(style="min-height: 200px;")
								div.col.text-center
									div.spinner-border.text-primary(role="status")

	if currentProjects.length > 0
		div.container.pb-5
			//- Project summary
			div#summary.jumbotron.py-2.px-3.pb-3.p-md-5.mb-3.text-white.rounded.bg-dark.position-relative
				img.position-absolute.pdm-project-badge(src=icon alt="" width="100")
				div.col-8.px-0.pb-1
					h1.font-italic= __("En ce moment : %s projets prioritaires", currentProjects.length)

				div.row
					each proj in currentProjects
						div.col-md-6.col-lg-4.h-100
							div.media.my-1.p-2(style="background-color: white; border-radius: 10px")
								a.align-self-center.mr-3(href=`/projects/${proj.id}`)
									img(src=proj.icon alt="" style="height: 100px")
								div.media-body.align-self-center
									a.text-decoration-none(href=`/projects/${proj.id}`)= proj.title
									if proj.stats && proj.stats.last30Days !== null && proj.stats.last30Days !== undefined
										- var count = proj.stats.last30Days || 0
										- // Plus vert = plus d'objets intégrés (0 = rouge, beaucoup = vert foncé)
										- // Utiliser une échelle logarithmique pour la couleur
										- var maxForColor = 1000 // Au-delà de 1000 objets, on considère que c'est vert foncé
										- var normalized = Math.min(100, (count / maxForColor) * 100)
										- var hue = Math.min(120, normalized * 1.2) // 0-120 (rouge à vert)
										- var saturation = Math.min(85, 30 + normalized * 0.55)
										- var lightness = Math.max(35, 50 - normalized * 0.15)
										- var badgeColor = `hsl(${Math.round(hue)}, ${Math.round(saturation)}%, ${Math.round(lightness)}%)`
										- var tooltipText = `Nombre d'objets intégrés au cours des 30 derniers jours (du ${new Date(proj.stats.pastTs).toLocaleDateString('fr-FR')} au ${new Date(proj.stats.currentTs).toLocaleDateString('fr-FR')})`
										div.mt-2
											span.badge(style=`background-color: ${badgeColor}; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.85em; font-weight: 500; cursor: help;` title=tooltipText)
												= `${count.toLocaleString('fr-FR')} objets`
											if proj.stats && proj.stats.etaDays !== null && proj.stats.etaDays !== undefined && proj.stats.remaining > 0
												- var etaDays = proj.stats.etaDays
												- var etaYears = etaDays / 365
												- var etaText = etaYears >= 1 ? Math.round(etaYears * 10) / 10 + " ans" : Math.ceil(etaDays) + " jours"
												- var showFire = etaDays < 365
												- var etaTooltip = "Temps estimé pour dépasser le nombre d'objets à intégrer (" + proj.stats.remaining.toLocaleString('fr-FR') + " objets) selon l'activité des 6 derniers mois (" + Math.round(proj.stats.last180Days / 180) + " objets/jour en moyenne)"
												div.mt-1
													span.badge(style=`background-color: ${showFire ? '#ff6b35' : '#4a90e2'}; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.85em; font-weight: 500; cursor: help;` title=etaTooltip)
														if showFire
															= "🔥 "
														= "ETA: " + etaText
									else if proj.stats && (proj.stats.last30Days === null || proj.stats.last30Days === undefined)
										- // Afficher "0 objets" pour les projets sans données encore
										div.mt-2
											span.badge(style="background-color: hsl(0, 70%, 50%); color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.85em; font-weight: 500; cursor: help;" title="Aucune donnée disponible pour les 30 derniers jours")
												= "0 objet"

	//- Other projects
	a#others
	div.container-fluid.pb-5
		div.container.blog-post
			h2.blog-post-title
				i.fa.fa-file-download.mr-2(style="font-size: 2.1rem")
				| #{__("Tous nos projets")}

			p= __("Retrouvez l'ensemble des projets du mois, leurs outils, statistiques et données.")
				div.row.align-items-center
					each proj in otherProjects
						div.col-md-6.col-lg-4.h-100
							div.media.mb-3
								a.align-self-center.mr-3(href=`/projects/${proj.id}`)
									img(src=proj.icon alt="" style="max-width: 100px")
								div.media-body.align-self-center
									a.text-decoration-none(href=`/projects/${proj.id}`)
										| #{proj.title}
										span.text-muted.d-block= new Date(proj.month).toLocaleString(getLocale(), { month: 'long', year: 'numeric' })
									if proj.stats && proj.stats.last30Days !== null && proj.stats.last30Days !== undefined
										- var count = proj.stats.last30Days || 0
										- // Plus vert = plus d'objets intégrés (0 = rouge, beaucoup = vert foncé)
										- var maxForColor = 1000
										- var normalized = Math.min(100, (count / maxForColor) * 100)
										- var hue = Math.min(120, normalized * 1.2)
										- var saturation = Math.min(85, 30 + normalized * 0.55)
										- var lightness = Math.max(35, 50 - normalized * 0.15)
										- var badgeColor = `hsl(${Math.round(hue)}, ${Math.round(saturation)}%, ${Math.round(lightness)}%)`
										- var tooltipText = `Nombre d'objets intégrés au cours des 30 derniers jours (du ${new Date(proj.stats.pastTs).toLocaleDateString('fr-FR')} au ${new Date(proj.stats.currentTs).toLocaleDateString('fr-FR')})`
										div.mt-1
											span.badge(style=`background-color: ${badgeColor}; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.85em; font-weight: 500; cursor: help;` title=tooltipText)
												= `${count.toLocaleString('fr-FR')} objets`
											if proj.stats && proj.stats.etaDays !== null && proj.stats.etaDays !== undefined && proj.stats.remaining > 0
												- var etaDays = proj.stats.etaDays
												- var etaYears = etaDays / 365
												- var etaText = etaYears >= 1 ? Math.round(etaYears * 10) / 10 + " ans" : Math.ceil(etaDays) + " jours"
												- var showFire = etaDays < 365
												- var etaTooltip = "Temps estimé pour dépasser le nombre d'objets à intégrer (" + proj.stats.remaining.toLocaleString('fr-FR') + " objets) selon l'activité des 6 derniers mois (" + Math.round(proj.stats.last180Days / 180) + " objets/jour en moyenne)"
												div.mt-1
													span.badge(style=`background-color: ${showFire ? '#ff6b35' : '#4a90e2'}; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.85em; font-weight: 500; cursor: help;` title=etaTooltip)
														if showFire
															= "🔥 "
														= "ETA: " + etaText
									else if proj.stats && (proj.stats.last30Days === null || proj.stats.last30Days === undefined)
										- // Afficher "0 objets" pour les projets sans données encore
										div.mt-1
											span.badge(style="background-color: hsl(0, 70%, 50%); color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.85em; font-weight: 500; cursor: help;" title="Aucune donnée disponible pour les 30 derniers jours")
												= "0 objet"

	//- Modals for podium explanations
	div.modal.fade#podium-contributions-modal(tabindex="-1" role="dialog")
		div.modal-dialog(role="document")
			div.modal-content
				div.modal-header
					h5.modal-title= __("Calcul du podium contributions")
					button.close(type="button" data-dismiss="modal" aria-label="Close")
						span(aria-hidden="true") &times;
				div.modal-body
					p= __("Ce podium classe les projets selon le nombre d'objets ajoutés au cours des 30 derniers jours.")
					p= __("Le calcul est effectué en comparant le nombre d'objets actuel avec le nombre d'objets il y a 30 jours :")
					ul
						li= __("Nombre d'objets ajoutés = Nombre actuel - Nombre il y a 30 jours")
						li= __("Seuls les projets avec au moins un objet ajouté sont pris en compte")
						li= __("Les projets sont classés par ordre décroissant du nombre d'objets ajoutés")
					p.text-muted= __("Les données sont mises à jour quotidiennement.")

	div.modal.fade#podium-quality-modal(tabindex="-1" role="dialog")
		div.modal-dialog(role="document")
			div.modal-content
				div.modal-header
					h5.modal-title= __("Calcul du podium qualité")
					button.close(type="button" data-dismiss="modal" aria-label="Close")
						span(aria-hidden="true") &times;
				div.modal-body
					p= __("Ce podium classe les projets selon l'augmentation de leur score de qualité moyen au cours des 30 derniers jours.")
					p= __("Le score de qualité moyen est calculé en fonction des tags requis définis dans la configuration de chaque projet :")
					ul
						li= __("Chaque objet a un pourcentage de complétion basé sur le nombre de tags requis présents")
						li= __("Le score moyen = moyenne des pourcentages de complétion de tous les objets du projet")
						li= __("Augmentation = Score moyen actuel - Score moyen il y a 30 jours")
						li= __("Seuls les projets avec une augmentation positive sont pris en compte")
					p.text-muted= __("Les données sont mises à jour quotidiennement.")

		script.
			// Load all projects stats asynchronously (non-blocking)
			fetch('/projects/all/stats')
				.then(res => {
					if (!res.ok) {
						throw new Error(`HTTP error! status: ${res.status}`);
					}
					return res.json();
				})
				.then(data => {
					if (!data || !data.projects) {
						throw new Error('Invalid data format from API');
					}
					
					const statsMap = data.projects;
					
					// Update stats for current projects
					const currentProjectsContainer = document.querySelector('#summary .row');
					if (currentProjectsContainer) {
						currentProjectsContainer.querySelectorAll('.media').forEach(mediaEl => {
							const link = mediaEl.querySelector('a[href^="/projects/"]');
							if (link) {
								const projectId = link.getAttribute('href').replace('/projects/', '');
								const stats = statsMap[projectId];
								if (stats) {
									updateProjectBadges(mediaEl, stats);
								}
							}
						});
					}
					
					// Update stats for other projects
					const otherProjectsContainer = document.querySelector('#others .row');
					if (otherProjectsContainer) {
						otherProjectsContainer.querySelectorAll('.media').forEach(mediaEl => {
							const links = mediaEl.querySelectorAll('a[href^="/projects/"]');
							if (links.length > 0) {
								const projectId = links[0].getAttribute('href').replace('/projects/', '');
								const stats = statsMap[projectId];
								if (stats) {
									updateProjectBadges(mediaEl, stats, true);
								}
							}
						});
					}
				})
				.catch(err => {
					console.error('Error loading all projects stats:', err);
					// Don't show error to user, just log it
				});
			
			// Helper function to update project badges
			function updateProjectBadges(mediaEl, stats, isOtherProject = false) {
				const mediaBody = mediaEl.querySelector('.media-body');
				if (!mediaBody) return;
				
				// Remove existing badges (look for badges after the title link)
				const titleLink = mediaBody.querySelector('a.text-decoration-none');
				if (titleLink) {
					let nextSibling = titleLink.nextSibling;
					while (nextSibling) {
						if (nextSibling.nodeType === 1 && (nextSibling.classList.contains('mt-2') || nextSibling.classList.contains('mt-1'))) {
							const toRemove = nextSibling;
							nextSibling = nextSibling.nextSibling;
							toRemove.remove();
						} else {
							nextSibling = nextSibling.nextSibling;
						}
					}
				}
				
				// Create badges container
				const badgesContainer = document.createElement('div');
				badgesContainer.classList.add(isOtherProject ? 'mt-1' : 'mt-2');
				
				if (stats.last30Days !== null && stats.last30Days !== undefined) {
					const count = stats.last30Days || 0;
					const maxForColor = 1000;
					const normalized = Math.min(100, (count / maxForColor) * 100);
					const hue = Math.min(120, normalized * 1.2);
					const saturation = Math.min(85, 30 + normalized * 0.55);
					const lightness = Math.max(35, 50 - normalized * 0.15);
					const badgeColor = `hsl(${Math.round(hue)}, ${Math.round(saturation)}%, ${Math.round(lightness)}%)`;
					
					const pastDate = stats.pastTs ? new Date(stats.pastTs).toLocaleDateString('fr-FR') : 'N/A';
					const currentDate = stats.currentTs ? new Date(stats.currentTs).toLocaleDateString('fr-FR') : 'N/A';
					const tooltipText = `Nombre d'objets intégrés au cours des 30 derniers jours (du ${pastDate} au ${currentDate})`;
					
					const countBadge = document.createElement('span');
					countBadge.classList.add('badge');
					countBadge.style.cssText = `background-color: ${badgeColor}; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.85em; font-weight: 500; cursor: help;`;
					countBadge.setAttribute('title', tooltipText);
					countBadge.textContent = `${count.toLocaleString('fr-FR')} objets`;
					badgesContainer.appendChild(countBadge);
					
					// Add ETA badge if available
					if (stats.etaDays !== null && stats.etaDays !== undefined && stats.remaining > 0) {
						const etaDays = stats.etaDays;
						const etaYears = etaDays / 365;
						const etaText = etaYears >= 1 ? Math.round(etaYears * 10) / 10 + " ans" : Math.ceil(etaDays) + " jours";
						const showFire = etaDays < 365;
						const avgPerDay = stats.last180Days ? Math.round(stats.last180Days / 180) : 0;
						const etaTooltip = `Temps estimé pour dépasser le nombre d'objets à intégrer (${stats.remaining.toLocaleString('fr-FR')} objets) selon l'activité des 6 derniers mois (${avgPerDay} objets/jour en moyenne)`;
						
						const etaContainer = document.createElement('div');
						etaContainer.classList.add('mt-1');
						
						const etaBadge = document.createElement('span');
						etaBadge.classList.add('badge');
						etaBadge.style.cssText = `background-color: ${showFire ? '#ff6b35' : '#4a90e2'}; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.85em; font-weight: 500; cursor: help;`;
						etaBadge.setAttribute('title', etaTooltip);
						etaBadge.textContent = (showFire ? "🔥 " : "") + "ETA: " + etaText;
						etaContainer.appendChild(etaBadge);
						badgesContainer.appendChild(etaContainer);
					}
					
					mediaBody.appendChild(badgesContainer);
				} else {
					// Show "0 objet" for projects without data
					const noDataBadge = document.createElement('div');
					noDataBadge.classList.add('mt-2');
					
					const badge = document.createElement('span');
					badge.classList.add('badge');
					badge.style.cssText = "background-color: hsl(0, 70%, 50%); color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.85em; font-weight: 500; cursor: help;";
					badge.setAttribute('title', "Aucune donnée disponible pour les 30 derniers jours");
					badge.textContent = "0 objet";
					noDataBadge.appendChild(badge);
					mediaBody.appendChild(noDataBadge);
				}
			}
			
			// Load all projects progress chart
			fetch('/api/all-projects-progress')
				.then(res => {
					if (!res.ok) {
						throw new Error(`HTTP error! status: ${res.status}`);
					}
					return res.json();
				})
				.then(data => {
					if (!data || !data.projects || !Array.isArray(data.projects)) {
						throw new Error('Invalid data format from API');
					}
					
					const chartContainer = document.getElementById("all-projects-chart").parentElement;
					const ctx = document.getElementById("all-projects-chart").getContext("2d");
					
					// Generate colors for each project
					const colors = [
						'#388E3C', '#1976D2', '#F57C00', '#7B1FA2', '#C2185B',
						'#0097A7', '#5D4037', '#455A64', '#E64A19', '#00796B',
						'#0288D1', '#F9A825', '#AD1457', '#6A1B9A', '#00695C'
					];
					
					const datasets = data.projects.map((proj, index) => ({
						label: proj.title,
						data: proj.data || [],
						fill: false,
						borderColor: colors[index % colors.length],
						lineTension: 0,
						pointRadius: 0,
						pointHoverRadius: 4
					}));

					if (datasets.length === 0) {
						throw new Error('No project data available');
					}

					const myChart = new Chart(ctx, {
						type: "line",
						data: { datasets: datasets },
						options: {
							responsive: true,
							scales: {
								xAxes: [{
									type: 'time',
									time: {
										tooltipFormat: "DD/MM/YYYY",
										displayFormats: { day: "DD/MM/YYYY", month: "MM/YYYY" }
									}
								}],
								yAxes: [{
									ticks: {
										beginAtZero: true,
										callback: function(value) {
											return new Intl.NumberFormat('fr-FR').format(value);
										}
									}
								}]
							},
							legend: {
								display: true,
								position: 'bottom'
							},
							plugins: {
								zoom: {
									pan: {
										enabled: true,
										mode: 'x',
										speed: 0.5
									},
									zoom: {
										enabled: true,
										mode: 'x',
										speed: 0.1,
										wheel: {
											enabled: true
										},
										pinch: {
											enabled: true
										}
									}
								}
							},
							onZoomComplete: function(scale) {
								const resetBtn = document.getElementById("chart-reset-zoom");
								if (resetBtn) resetBtn.style.display = "inline-block";
							}
						}
					});
					
					// Reset zoom button
					const resetBtn = document.getElementById("chart-reset-zoom");
					if (resetBtn) {
						resetBtn.addEventListener("click", () => {
							if (myChart.resetZoom) {
								myChart.resetZoom();
							}
							resetBtn.style.display = "none";
						});
						
						// Show reset button when zoomed (using onZoomComplete callback)
						// The callback is already set in the chart options
					}
					
					// Export button
					const exportBtn = document.getElementById("chart-export");
					if (exportBtn) {
						exportBtn.addEventListener("click", () => {
							const url = myChart.toBase64Image();
							const link = document.createElement("a");
							link.download = "progression-projets-" + new Date().toISOString().split("T")[0] + ".png";
							link.href = url;
							link.click();
						});
					}

					const spinner = chartContainer.querySelector(".spinner-charts");
					if (spinner) spinner.remove();
				})
