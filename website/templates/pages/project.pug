					script.
						(function() {
							const deptInput = document.getElementById("josm-department-select");
							const loadBtn = document.getElementById("josm-load-btn");
							const statusDiv = document.getElementById("josm-status");
							const projectFilter = !{JSON.stringify(database.osmium_tag_filter || "")};
							const josmRemoteUrl = !{JSON.stringify(CONFIG.JOSM_REMOTE_URL || "http://localhost:8111")};
							
							// Extract filter parts from osmium_tag_filter (e.g., "n/amenity=street_lamp" -> {type: "node", tags: {amenity: "street_lamp"}})
							function parseFilter(filterStr) {
								if (!filterStr) return null;
								const parts = filterStr.split("/");
								const type = parts[0] || "nwr"; // n, w, r, or nwr
								const tagParts = (parts[1] || "").split("=");
								if (tagParts.length === 2) {
									return {
										type: type === "n" ? "node" : type === "w" ? "way" : type === "r" ? "relation" : "nwr",
										key: tagParts[0],
										value: tagParts[1]
									};
								}
								return { type: "nwr", key: null, value: null };
							}
							
							// Build Overpass query
							function buildOverpassQuery(departmentCode) {
								const filter = parseFilter(projectFilter);
								if (!filter) return null;
								
								const type = filter.type === "node" ? "node" : filter.type === "way" ? "way" : filter.type === "relation" ? "relation" : "(node;way;relation)";
								const tagFilter = filter.key && filter.value ? "[" + JSON.stringify(filter.key) + "=" + JSON.stringify(filter.value) + "]" : "";
								
								var query = "[out:xml][timeout:25];\n";
								query += "(\n";
								query += "  relation[\"admin_level\"=\"6\"][\"ref\"=\"" + departmentCode + "\"];\n";
								query += ");\n";
								query += "map_to_area;\n";
								query += "(\n";
								query += "  " + type + tagFilter + "(area);\n";
								query += ");\n";
								query += "(._;>;);\n";
								query += "out meta;";
								return query;
							}
							
							// Enable/disable button based on input
							deptInput.addEventListener("input", function() {
								const code = deptInput.value.trim();
								loadBtn.disabled = !code || code.length < 2 || code.length > 3;
							});
							
							// Load in JOSM
							loadBtn.addEventListener("click", async function() {
								const deptCode = deptInput.value.trim();
								if (!deptCode) return;
								
								loadBtn.disabled = true;
								statusDiv.innerHTML = '<div class="alert alert-info"><i class="fa fa-spinner fa-spin mr-2"></i>#{__("Génération de la requête Overpass...")}</div>';
								
								const query = buildOverpassQuery(deptCode);
								if (!query) {
									statusDiv.innerHTML = '<div class="alert alert-danger">#{__("Erreur : Impossible de générer la requête Overpass.")}</div>';
									loadBtn.disabled = false;
									return;
								}
								
								try {
									// Encode query for Overpass API
									const encodedQuery = encodeURIComponent(query);
									const overpassUrl = "https://overpass-api.de/api/interpreter?data=" + encodedQuery;
									
									// Send Overpass URL directly to JOSM via remote control
									// JOSM will execute the Overpass query itself
									statusDiv.innerHTML = '<div class="alert alert-info"><i class="fa fa-spinner fa-spin mr-2"></i>#{__("Envoi de la requête Overpass à JOSM...")}</div>';
									
									const josmUrl = josmRemoteUrl + "/import?url=" + encodeURIComponent(overpassUrl);
									const josmResponse = await fetch(josmUrl);
									
									if (!josmResponse.ok) {
										throw new Error("JOSM remote control error: " + josmResponse.status);
									}
									
									statusDiv.innerHTML = '<div class="alert alert-success"><i class="fa fa-check-circle mr-2"></i>#{__("Requête Overpass envoyée à JOSM avec succès ! JOSM va télécharger les données.")}</div>';
								} catch (error) {
									console.error("Error loading in JOSM:", error);
									statusDiv.innerHTML = '<div class="alert alert-danger"><i class="fa fa-exclamation-triangle mr-2"></i>#{__("Erreur :")} ' + error.message + '. #{__("Vérifiez que JOSM est lancé et que la télécommande est activée.")}</div>';
								} finally {
									loadBtn.disabled = false;
								}
							});
						})();

