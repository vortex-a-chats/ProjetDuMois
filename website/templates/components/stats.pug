					// Gestionnaire pour le collapse
					const toggle = document.getElementById('quality-current-toggle');
					const collapse = document.getElementById('quality-current-collapse');
					const collapseIcon = document.getElementById('quality-current-icon');
					
					if (toggle && collapse && collapseIcon) {
						toggle.addEventListener('click', function() {
							const isExpanded = collapse.classList.contains('show');
							
							if (isExpanded) {
								collapse.classList.remove('show');
								collapse.style.display = 'none';
								collapseIcon.classList.remove('fa-chevron-up');
								collapseIcon.classList.add('fa-chevron-down');
							} else {
								collapse.classList.add('show');
								collapse.style.display = 'block';
								collapseIcon.classList.remove('fa-chevron-down');
								collapseIcon.classList.add('fa-chevron-up');
							}
						});
					}
				}
			}
			else {
				document.getElementById("stats-chart-quality-container").classList.add("d-none");
			}

			// Boundary stats map
			const mapStatsContainer = document.getElementById("map-stats");
			mapStatsContainer.classList.remove("pdm-loading");

			if(res.mapStyle) {
				const isMobile = window.innerWidth < 576;
				const mapStats = new maplibregl.Map({
					container: 'map-stats',
					pitchWithRotate: false,
					dragRotate: false,
					center: [2.5, 46.0],
					zoom: 4,
					style: res.mapStyle.style,
					minZoom: 4,
					maxZoom: 10
				});

				// Add OSM logo to map after it loads
				mapStats.on('load', () => {
					const osmLogoLink = document.createElement('a');
					osmLogoLink.href = 'https://www.openstreetmap.org';
					osmLogoLink.target = '_blank';
					osmLogoLink.style.cssText = 'position: absolute; bottom: 50px; left: 10px; z-index: 1000; opacity: 0.8; pointer-events: auto;';
					const osmLogo = document.createElement('img');
					osmLogo.src = 'https://wiki.openstreetmap.org/w/images/7/79/Public-images-osm_logo.svg';
					osmLogo.alt = 'OpenStreetMap';
					osmLogo.style.cssText = 'height: 30px;';
					osmLogoLink.appendChild(osmLogo);
					mapStatsContainer.appendChild(osmLogoLink);
				});

				const basePopupSize = isMobile ? 250 : 400;
				const popupHover = new maplibregl.Popup({ closeButton: false, closeOnClick: false, anchor: "left" });
				const popupClick = new maplibregl.Popup({ closeOnClick: false, className: 'map-stats-popup', maxWidth: basePopupSize+'px' });
				const fsctrl = new maplibregl.FullscreenControl();

				if(isMobile) {
					const interactions = ["scrollZoom", "dragPan", "doubleClickZoom", "touchZoomRotate"];
					interactions.forEach(it => mapStats[it].disable());

					const fsctrl = new maplibregl.FullscreenControl();
					window.addEventListener(fsctrl._fullscreenchange, () => {
						if(fsctrl._isFullscreen()) {
							interactions.forEach(it => mapStats[it].enable());
						}
						else {
							interactions.forEach(it => mapStats[it].disable());
						}
					});
					mapStats.addControl(fsctrl);
				}

				mapStats.on("click", "stats_0", e => {
					const f = e.features.pop();

					if(f) {
						mapStats.getCanvas().style.cursor = 'pointer';
						const coords = f.geometry.coordinates.slice();

						while (Math.abs(e.lngLat.lng - coords[0]) > 180) {
							coords[0] += e.lngLat.lng > coords[0] ? 360 : -360;
						}

						const div = document.createElement("div");
						div.style.height = (basePopupSize/2)+"px";
						div.style.width = (basePopupSize+20)+"px";
						const canvas = document.createElement("canvas");
						canvas.style.maxWidth = (basePopupSize-20)+"px";
						canvas.style.maxHeight = (basePopupSize/2)+"px";

						const fStats = JSON.parse(f.properties.stats);
						const myChart = new Chart(canvas.getContext("2d"), {
							type: "line",
							data: {
								datasets: [{
									label: "#{__("Nombre total")}",
									data: projectDays.map(d => ({ t: d, y: fStats[d] || 0 })).filter((d,i) => d.y != 0 || i < projectDays.length - 1),
									fill: false,
									borderColor: "#388E3C",
									lineTension: 0
								}]
							},
							options: {
								responsive: true,
								scales: {
									xAxes: [{
										type: 'time',
										bounds: 'ticks',
										time: {
											tooltipFormat: "DD/MM",
											displayFormats: { day: "DD/MM" },
											round: "day",
											unit: "day"
										}
									}],
									yAxes: [ yAxeLinear ]
								}
							}
						});

						const nameDiv = document.createElement("div");
						nameDiv.style.fontWeight = "bold";
						nameDiv.style.marginBottom = "10px";
						nameDiv.appendChild(document.createTextNode(f.properties.name));
						div.appendChild(nameDiv);
						div.appendChild(canvas);

						const linkDiv = document.createElement("div");
						linkDiv.style.marginTop = "10px";
						linkDiv.style.textAlign = "center";
						const link = document.createElement("a");
						link.href = '/projects/' + projectId + '/zones/' + Math.abs(f.properties.boundary);
						link.textContent = "#{__('Voir les détails de la zone')}";
						link.classList.add("btn", "btn-sm", "btn-primary");
						linkDiv.appendChild(link);
						div.appendChild(linkDiv);

						popupHover.remove();
						popupClick.setLngLat(coords).setDOMContent(div).addTo(mapStats);
					}
				});

				mapStats.on("mousemove", "stats_0", e => {
					if(isMobile) { return; }
					const f = e.features.pop();

					if(f) {
						mapStats.getCanvas().style.cursor = 'pointer';
						const coords = f.geometry.coordinates.slice();

						while (Math.abs(e.lngLat.lng - coords[0]) > 180) {
							coords[0] += e.lngLat.lng > coords[0] ? 360 : -360;
						}

						const div = document.createElement("div");
						div.appendChild(document.createTextNode(`${f.properties.name} : ${f.properties.nb}`));
						popupHover.setLngLat(coords).setDOMContent(div).addTo(mapStats);
					}
				});

				mapStats.on("mouseleave", "stats_0", () => {
					mapStats.getCanvas().style.cursor = '';
					popupHover.remove();
				});

				// Boundary stats legends
				const mapStatsLegend = document.getElementById("map-stats-legend");
				mapStatsLegend.innerHTML = '';
				const admLvlToText = { "4": "#{__("Région")}", "6": "#{__("Département")}", "8": "#{__("Commune")}" };
				Object.entries(res.mapStyle.legend).forEach(e => {
					const [lvl, data] = e;

					const div = document.createElement("div");
					div.classList.add("col-md-4", "d-flex", "justify-content-start", "align-items-center");
					const symbol1 = document.createElement("div");
					symbol1.classList.add("map-stats-symbol");
					symbol1.style.width = `${Math.ceil(data.minSize*1.5)}px`;
					symbol1.style.height = `${Math.ceil(data.minSize*1.5)}px`;
					symbol1.style.borderRadius = `${Math.ceil(data.minSize*1.5/2)}px`;
					symbol1.style.backgroundColor = data.color;

					const symbol2 = symbol1.cloneNode(true);
					symbol2.style.width = `${Math.ceil(data.maxSize*1.5)}px`;
					symbol2.style.height = `${Math.ceil(data.maxSize*1.5)}px`;
					symbol2.style.borderRadius = `${Math.ceil(data.maxSize*1.5/2)}px`;

					div.appendChild(document.createTextNode(`${admLvlToText[lvl]} : ${data.minValue}`));
					div.appendChild(symbol1);
					div.appendChild(symbol2);
					div.appendChild(document.createTextNode(data.maxValue));
					mapStatsLegend.appendChild(div);
				});
			}
			else {
				mapStatsContainer.parentNode.classList.add("d-none");
			}
		});

		// Load zone podiums
		if(projectId) {
			fetch('/projects/' + projectId + '/zones-podiums')
				.then(res => res.json())
				.then(data => {
					// Quality podium
					const qualityPodium = document.getElementById("podium-cities-quality");
					const qualitySpinner = qualityPodium.querySelector(".spinner-border");
					if(qualitySpinner) qualitySpinner.remove();
					qualityPodium.innerHTML = '';
					
					if(data.quality && data.quality.length > 0) {
						const list = document.createElement("div");
						list.classList.add("list-group", "w-100");
						
						data.quality.forEach((city, index) => {
							const item = document.createElement("a");
							item.classList.add("list-group-item", "list-group-item-action", "d-flex", "justify-content-between", "align-items-center");
							item.href = "/projects/" + projectId + "/zones/" + Math.abs(city.boundary_id);
							
							const rank = document.createElement("span");
							rank.classList.add("badge", "badge-primary", "badge-pill", "mr-2");
							rank.textContent = (index + 1);
							rank.style.minWidth = "30px";
							
							const name = document.createElement("span");
							name.textContent = city.name;
							name.style.flex = "1";
							
							const score = document.createElement("span");
							score.classList.add("badge", "badge-success", "badge-pill");
							score.textContent = city.avg_completion.toFixed(1) + "%";
							
							const count = document.createElement("small");
							count.classList.add("text-muted", "ml-2");
							count.textContent = "(" + city.object_count + " objets)";
							
							item.appendChild(rank);
							item.appendChild(name);
							item.appendChild(score);
							item.appendChild(count);
							list.appendChild(item);
						});
						
						qualityPodium.appendChild(list);
					} else {
						qualityPodium.innerHTML = '<p class="text-muted">Aucune donnée disponible</p>';
					}

					// Progress podium
					const progressPodium = document.getElementById("podium-cities-progress");
					const progressSpinner = progressPodium.querySelector(".spinner-border");
					if(progressSpinner) progressSpinner.remove();
					progressPodium.innerHTML = '';
					
					if(data.progress && data.progress.length > 0) {
						const list = document.createElement("div");
						list.classList.add("list-group", "w-100");
						
						data.progress.forEach((city, index) => {
							const item = document.createElement("a");
							item.classList.add("list-group-item", "list-group-item-action", "d-flex", "justify-content-between", "align-items-center");
							item.href = "/projects/" + projectId + "/zones/" + Math.abs(city.boundary_id);
							
							const rank = document.createElement("span");
							rank.classList.add("badge", "badge-primary", "badge-pill", "mr-2");
							rank.textContent = (index + 1);
							rank.style.minWidth = "30px";
							
							const name = document.createElement("span");
							name.textContent = city.name;
							name.style.flex = "1";
							
							const added = document.createElement("span");
							added.classList.add("badge", "badge-success", "badge-pill");
							added.textContent = "+" + city.added.toLocaleString('fr-FR');
							
							const count = document.createElement("small");
							count.classList.add("text-muted", "ml-2");
							count.textContent = "(" + city.current_amount.toLocaleString('fr-FR') + " objets)";
							
							item.appendChild(rank);
							item.appendChild(name);
							item.appendChild(added);
							item.appendChild(count);
							list.appendChild(item);
						});
						
						progressPodium.appendChild(list);
					} else {
						progressPodium.innerHTML = '<p class="text-muted">Aucune donnée disponible</p>';
					}
				})
				.catch(err => {
					console.error('Error loading zone podiums:', err);
					document.getElementById("podium-cities-quality").innerHTML = '<p class="text-danger">Erreur lors du chargement</p>';
					document.getElementById("podium-cities-progress").innerHTML = '<p class="text-danger">Erreur lors du chargement</p>';
				});
			
			// Load deletions statistics
			fetch('/projects/' + projectId + '/deletions')
				.then(res => {
					if (!res.ok) {
						throw new Error(`HTTP error! status: ${res.status}`);
					}
					return res.json();
				})
				.then(data => {
					if (!data || !data.chart || !Array.isArray(data.chart) || data.chart.length === 0) {
						// Hide deletions container if no data
						document.getElementById("stats-deletions-container").classList.add("d-none");
						return;
					}
					
					// Show deletions container
					document.getElementById("stats-deletions-container").classList.remove("d-none");
					const spinner = document.querySelector("#stats-deletions-container .spinner-charts-deletions");
					if (spinner) spinner.classList.add("d-none");
					
					// Display deletions chart as histogram with zoom
					const ctxDeletions = document.getElementById("stats-deletions-chart").getContext("2d");
					const myChartDeletions = new Chart(ctxDeletions, {
						type: "bar",
						data: {
							datasets: [{
								label: "#{__('Nombre de suppressions')}",
								data: data.chart,
								backgroundColor: "rgba(211, 47, 47, 0.6)",
								borderColor: "#D32F2F",
								borderWidth: 1
							}]
						},
						options: {
							responsive: true,
							scales: {
								xAxes: [{
									type: 'time',
									time: {
										tooltipFormat: "DD/MM/YYYY",
										displayFormats: { day: "DD/MM/YYYY", month: "MM/YYYY" }
									},
									barThickness: 'flex',
									categoryPercentage: 0.8,
									barPercentage: 0.9
								}],
								yAxes: [{
									ticks: {
										beginAtZero: true,
										callback: function(value) {
											return numberFormat.format(value);
										}
									}
								}]
							},
							legend: {
								display: true,
								position: 'bottom'
							},
							plugins: {
								zoom: {
									pan: {
										enabled: true,
										mode: 'x',
										speed: 0.5
									},
									zoom: {
										enabled: true,
										mode: 'x',
										speed: 0.1,
										wheel: {
											enabled: true,
											speed: 0.1
										},
										pinch: {
											enabled: true
										}
									}
								}
							}
						}
					});
					
					// Handle zoom reset button
					const resetZoomBtn = document.getElementById("deletions-chart-reset-zoom");
					if (resetZoomBtn) {
						myChartDeletions.resetZoom = function() {
							Chart.helpers.each(myChartDeletions.data.datasets, function(dataset) {
								myChartDeletions.resetZoom();
							});
						};
						resetZoomBtn.addEventListener('click', function() {
							myChartDeletions.resetZoom();
							resetZoomBtn.style.display = 'none';
						});
						
						// Show reset button when zoomed
						myChartDeletions.options.onZoom = function() {
							resetZoomBtn.style.display = 'block';
						};
					}
					
					// Display changesets list
					if (data.changesets && data.changesets.length > 0) {
						const changesetsList = document.getElementById("deletions-changesets-list");
						changesetsList.innerHTML = '';
						
						// Debug: log first changeset to see structure
						if (data.changesets.length > 0) {
							console.log('First changeset data:', data.changesets[0]);
						}
						
						data.changesets.forEach(changeset => {
							const tr = document.createElement("tr");
							
							// Date
							const tdDate = document.createElement("td");
							const date = new Date(changeset.date);
							tdDate.textContent = date.toLocaleDateString('fr-FR');
							tr.appendChild(tdDate);
							
							// Username with link to osm.org
							const tdUser = document.createElement("td");
							if (changeset.osm_user_url) {
								const userLink = document.createElement("a");
								userLink.href = changeset.osm_user_url;
								userLink.target = "_blank";
								userLink.rel = "noopener noreferrer";
								userLink.textContent = changeset.username;
								tdUser.appendChild(userLink);
							} else if (changeset.userid) {
								const userLink = document.createElement("a");
								userLink.href = '/users/' + encodeURIComponent(changeset.username);
								userLink.textContent = changeset.username;
								tdUser.appendChild(userLink);
							} else {
								tdUser.textContent = changeset.username;
							}
							tr.appendChild(tdUser);
							
							// Changeset ID - always add this column
							const tdChangesetId = document.createElement("td");
							if (changeset.changeset_id != null && changeset.changeset_id !== undefined) {
								tdChangesetId.textContent = String(changeset.changeset_id);
								tdChangesetId.style.fontFamily = "monospace";
							} else {
								tdChangesetId.textContent = '-';
								tdChangesetId.classList.add("text-muted");
							}
							tr.appendChild(tdChangesetId);
							
							// Deletion count
							const tdCount = document.createElement("td");
							tdCount.textContent = numberFormat.format(changeset.deletion_count);
							tr.appendChild(tdCount);
							
							// Actions (Achavi and OSM links)
							const tdActions = document.createElement("td");
							tdActions.style.whiteSpace = "nowrap";
							
							// Achavi link - ensure changeset_id is in URL if available
							const achaviLink = document.createElement("a");
							if (changeset.changeset_id) {
								// Use changeset ID directly in URL
								achaviLink.href = 'https://overpass-api.de/achavi/?changeset=' + changeset.changeset_id;
							} else {
								// Fallback to the URL from API
								achaviLink.href = changeset.achavi_url;
							}
							achaviLink.target = "_blank";
							achaviLink.rel = "noopener noreferrer";
							achaviLink.classList.add("btn", "btn-sm", "btn-outline-primary", "mr-1");
							if (changeset.changeset_id) {
								achaviLink.innerHTML = '<i class="fa fa-external-link-alt mr-1"></i>#{__("Achavi")} (' + changeset.changeset_id + ')';
							} else {
								achaviLink.innerHTML = '<i class="fa fa-external-link-alt mr-1"></i>#{__("Achavi")}';
							}
							tdActions.appendChild(achaviLink);
							
							// OSM changeset link (if available)
							if (changeset.osm_changeset_url) {
								const osmLink = document.createElement("a");
								osmLink.href = changeset.osm_changeset_url;
								osmLink.target = "_blank";
								osmLink.rel = "noopener noreferrer";
								osmLink.classList.add("btn", "btn-sm", "btn-outline-info");
								osmLink.innerHTML = '<i class="fa fa-map-marker-alt mr-1"></i>OSM (' + changeset.changeset_id + ')';
								tdActions.appendChild(osmLink);
							}
							
							tr.appendChild(tdActions);
							
							changesetsList.appendChild(tr);
						});
					} else {
						const changesetsList = document.getElementById("deletions-changesets-list");
						changesetsList.innerHTML = '<tr><td colspan="5" class="text-center text-muted">#{__("Aucun changeset avec suppressions trouvé")}</td></tr>';
					}
				})
				.catch(err => {
					console.error('Error loading deletions:', err);
					// Hide deletions container on error
					document.getElementById("stats-deletions-container").classList.add("d-none");
				});
		}
	};
	

	let delayDisplayStats;
	const timerShowStats = () => {
		if(delayDisplayStats) { clearTimeout(delayDisplayStats); }
		delayDisplayStats = setTimeout(showStatistics, 1000);
	};

	window.addEventListener("osm_login", () => {
		timerShowStats();
	});

	window.addEventListener("osm_logout", () => {
		document.getElementById("stats-leaderboard-container").classList.add("d-none");
		document.getElementById("stats-leaderboard-noauth").classList.remove("d-none");
	});

	// Modal handlers for zone podiums explanations
	document.querySelectorAll('[data-toggle="modal"][data-target]').forEach(button => {
		button.addEventListener('click', function(e) {
			e.preventDefault();
			const targetId = this.getAttribute('data-target');
			const modal = document.querySelector(targetId);
			if (modal) {
				// Remove existing backdrop if any
				const existingBackdrop = document.querySelector('.modal-backdrop');
				if (existingBackdrop) existingBackdrop.remove();
				
				// Show modal
				modal.classList.add('show');
				modal.style.display = 'block';
				modal.setAttribute('aria-hidden', 'false');
				document.body.classList.add('modal-open');
				
				// Create and append backdrop
				const backdrop = document.createElement('div');
				backdrop.className = 'modal-backdrop fade show';
				document.body.appendChild(backdrop);
				
				// Close function
				const closeModal = () => {
					modal.classList.remove('show');
					modal.style.display = 'none';
					modal.setAttribute('aria-hidden', 'true');
					document.body.classList.remove('modal-open');
					const backdropEl = document.querySelector('.modal-backdrop');
					if (backdropEl) backdropEl.remove();
				};
				
				// Close on backdrop click
				backdrop.addEventListener('click', closeModal);
				
				// Close on close button click (remove old listeners first)
				modal.querySelectorAll('[data-dismiss="modal"]').forEach(closeBtn => {
					// Remove old listeners by cloning
					const newCloseBtn = closeBtn.cloneNode(true);
					closeBtn.parentNode.replaceChild(newCloseBtn, closeBtn);
					newCloseBtn.addEventListener('click', function(e) {
						e.preventDefault();
						closeModal();
					});
				});
			}
		});
	});

	timerShowStats();
