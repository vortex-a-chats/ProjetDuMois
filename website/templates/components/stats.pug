			// Evolution chart
			const ctx = document.getElementById("stats-chart").getContext("2d");
			
			// Prepare datasets with vertical line for project start date
			const chartDatasets = [...res.chart];
			if(res.projectStartDate && res.chart && res.chart.length > 0) {
				// Find min and max Y values to draw vertical line
				let minY = Infinity;
				let maxY = -Infinity;
				res.chart.forEach(dataset => {
					dataset.data.forEach(point => {
						if(point.y != null && !isNaN(point.y)) {
							minY = Math.min(minY, point.y);
							maxY = Math.max(maxY, point.y);
						}
					});
				});
				
				// Add vertical line dataset for project start date
				if(minY !== Infinity && maxY !== -Infinity) {
					const startDate = new Date(res.projectStartDate + 'T00:00:00Z').toISOString();
					chartDatasets.push({
						label: '#{__("Début du projet")}',
						data: [
							{ t: startDate, y: minY },
