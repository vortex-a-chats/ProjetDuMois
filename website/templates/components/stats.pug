script.
	const projectDays = !{JSON.stringify(days)};
	const projectId = window.location.pathname.match(/\/projects\/([^\/]+)/)?.[1] || !{JSON.stringify(id)};
	
	const showStatistics = function() {
		const numberFormat = new Intl.NumberFormat();

		if (!projectId) {
			console.error("Project ID not found");
			return;
		}

		fetch("/projects/"+projectId+"/stats"+(window.osm_user ? "?osm_user="+window.osm_user.name : ""))
		.then(res => {
			if (!res.ok) {
				throw new Error(`HTTP error! status: ${res.status}`);
			}
			return res.json();
		})
		.then(res => {
			const blocks = document.getElementById("stats-blocks");
			blocks.innerHTML = '';
			const addBlock = (title, subtitle, extraInfo, infoButton) => {
				const b = document.createElement("div");
				b.classList.add("col-md-4", "mb-2");

				const sb = document.createElement("div");
				sb.classList.add("p-4", "no-gutters", "border", "rounded", "overflow-hidden", "flex-md-row", "shadow-sm", "position-relative", "h-100");
				b.appendChild(sb);

				const headerDiv = document.createElement("div");
				headerDiv.classList.add("d-flex", "justify-content-between", "align-items-start", "mb-2");
				
				const t = document.createElement("h3");
				t.classList.add("mb-0");
				t.appendChild(document.createTextNode(title));
				headerDiv.appendChild(t);
				
				if (infoButton) {
					const infoBtn = document.createElement("button");
					infoBtn.classList.add("btn", "btn-sm", "btn-link", "p-0", "ml-2");
					infoBtn.style.cssText = "padding: 0; vertical-align: baseline; line-height: 1;";
					infoBtn.setAttribute("type", "button");
					infoBtn.setAttribute("data-toggle", "modal");
					infoBtn.setAttribute("data-target", infoButton.target);
					const icon = document.createElement("i");
					icon.classList.add("fa", "fa-info-circle");
					infoBtn.appendChild(icon);
					headerDiv.appendChild(infoBtn);
				}
				
				sb.appendChild(headerDiv);

				const st = document.createElement("p");
				st.classList.add("card-text", "mb-auto");
				st.appendChild(document.createTextNode(subtitle));
				sb.appendChild(st);
				
				if (extraInfo) {
					const extra = document.createElement("p");
					extra.classList.add("card-text", "text-muted", "small", "mt-2", "mb-0");
					extra.appendChild(document.createTextNode(extraInfo));
					sb.appendChild(extra);
				}

				blocks.appendChild(b);
			};

			// Blocks for small stats
			if(res.added) {
				let dateInfo = "";
				if(res.projectStartDate && res.projectEndDate) {
					const startDate = new Date(res.projectStartDate + 'T00:00:00Z');
					const endDate = new Date(res.projectEndDate + 'T23:59:59Z');
					dateInfo = "#{__("Période")}: " + startDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) + " - " + endDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
				}
				addBlock(numberFormat.format(res.added), "#{title.toLowerCase()} ajoutés 🧭", dateInfo);
			}
			if(res.count) {
				addBlock(
					numberFormat.format(res.count),
					"#{title.toLowerCase()} au total dans OSM 🗺️",
					null,
					{ target: "#stats-count-difference-modal" }
				);
			}
			if(res.tasksSolved !== undefined) { addBlock(numberFormat.format(res.tasksSolved), "#{statistics.osmose_tasks} ✅"); }
			addBlock(numberFormat.format(res.nbContributors), "#{__("personnes ayant contribué")} 👥");
			if(res.addedWeek != null) { addBlock(numberFormat.format(res.addedWeek), "#{__("Ajouts sur 7 jours")} 📆"); }
			if(res.added30d != null) { addBlock(numberFormat.format(res.added30d), "#{__("Ajouts sur 30 jours")} 🗓️"); }
			if(res.added180d != null) { addBlock(numberFormat.format(res.added180d), "#{__("Ajouts sur 6 mois")} 📈"); }
			
			// Osmose ETA block (for "à ajouter" tasks)
			if(res.osmoseRemaining != null && res.osmoseRemaining > 0) {
				if(res.osmoseEtaDays != null && res.osmoseEtaDays > 0) {
					const etaText = res.osmoseEtaDays < 365 
						? res.osmoseEtaDays + " " + (res.osmoseEtaDays > 1 ? "#{__("jours")}" : "#{__("jour")}")
						: Math.round(res.osmoseEtaDays / 365 * 10) / 10 + " " + (Math.round(res.osmoseEtaDays / 365 * 10) / 10 > 1 ? "#{__("ans")}" : "#{__("an")}");
					addBlock(etaText, "#{__("Temps estimé pour compléter les tâches Osmose à ajouter")} ⏱️");
				} else {
					addBlock("#{__("Indéterminé")}", "#{__("Temps estimé pour compléter les tâches Osmose à ajouter")} ⏱️");
				}
			}
			if(res.added365d != null) { addBlock(numberFormat.format(res.added365d), "#{__("Ajouts sur 12 mois")} 🚀"); }
			if(res.avgPerContributor != null) { addBlock(res.avgPerContributor.toFixed(1), "#{__("Objets ajoutés / personne (moy.)")} 🧑‍💻"); }
			if(res.remaining != null) { addBlock(numberFormat.format(res.remaining), "#{__("Objets restants (estim.)")} ⏳"); }
			if(res.remainingPerContributor != null) { addBlock(numberFormat.format(res.remainingPerContributor), "#{__("Restant / personne (estim.)")} 🙋"); }
			if(res.etaDays != null) {
				const etaDays = Math.ceil(res.etaDays);
				let etaText = "";
				if(etaDays < 30) {
					etaText = etaDays + " jours";
				} else {
					const years = Math.floor(etaDays / 365);
					const months = Math.floor((etaDays % 365) / 30);
					if(years > 0 && months > 0) {
						etaText = years + " an" + (years > 1 ? "s" : "") + " et " + months + " mois";
					} else if(years > 0) {
						etaText = years + " an" + (years > 1 ? "s" : "");
					} else {
						etaText = months + " mois";
					}
				}
				addBlock("~" + etaText, "#{__("Jours restants au rythme actuel (estim.)")} 🕒");
			}
			if(res.avgPerCommune != null) { addBlock(numberFormat.format(res.avgPerCommune.toFixed(1)), "#{__("Objets intégrés / commune (estim.)")} 🏘️"); }
			if(res.contributorsPerCommune != null) { addBlock(res.contributorsPerCommune.toFixed(2), "#{__("Contributeurs / commune (estim.)")} 🤝"); }

			// Leaderboard
			if(res.leaderboard && res.leaderboard.length > 0) {
				let wordCloud = [];
				document.getElementById("stats-leaderboard-container").classList.remove("d-none");
				document.getElementById("stats-leaderboard-noauth").classList.add("d-none");

				const leaderboardBody = document.getElementById("stats-leaderboard");
				leaderboardBody.innerHTML = '';
				const podium = document.getElementById("stats-podium");
				podium.innerHTML = '';

				const podiumStyle = [ [125, "#F9A825"], [100, "#1E88E5"], [75, "#42A5F5"], [50, "#90CAF9"] ];

				res.leaderboard.map((lb,i) => {
					const tr = document.createElement("tr");

					const td1 = document.createElement("td");
					td1.setAttribute("scope", "row");
					td1.appendChild(document.createTextNode(lb.pos));
					td1.classList.add("align-middle");
					tr.appendChild(td1);

					const td2 = document.createElement("td");
					const td2Link = document.createElement("a");
					td2Link.href=`/users/${encodeURIComponent(lb.username)}`;
					td2Link.appendChild(document.createTextNode(lb.username));
					td2.appendChild(td2Link);
					td2.classList.add("align-middle");
					tr.appendChild(td2);

					const td3 = document.createElement("td");
					td3.appendChild(document.createTextNode(numberFormat.format(lb.amount)));
					td3.classList.add("align-middle", "text-right", "pr-2");
					tr.appendChild(td3);

					// Add to podium
					if(i < 3 || lb.userid === window.osm_user.id) {
						const podiumStep = document.createElement("div");
						podiumStep.classList.add("col", "text-center");
