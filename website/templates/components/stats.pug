											tooltipFormat: "MMMM YYYY",
											displayFormats: { month: "MMMM" },
											round: "month",
											unit: "month"
										}
									}],
									yAxes: [{
										ticks: {
											callback: function(value) {
												return value > 0 ? '+' + numberFormat.format(value) : numberFormat.format(value);
											}
										}
									}]
								},
								legend: {
									display: true
								},
								tooltips: {
									callbacks: {
										label: function(tooltipItem, data) {
											const value = tooltipItem.yLabel;
											return data.datasets[tooltipItem.datasetIndex].label + ': ' + (value > 0 ? '+' : '') + numberFormat.format(value);
										}
									}
								}
							}
						});
					} else {
						document.getElementById("stats-variation-monthly-chart-container").classList.add("d-none");
					}
