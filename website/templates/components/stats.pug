									callback: function(value) {
										return value > 0 ? '+' + numberFormat.format(value) : numberFormat.format(value);
									}
								}
							}]
						},
						legend: {
							display: true
						},
						tooltips: {
							callbacks: {
								label: function(tooltipItem, data) {
									const value = tooltipItem.yLabel;
									return data.datasets[tooltipItem.datasetIndex].label + ': ' + (value > 0 ? '+' : '') + numberFormat.format(value);
								}
							}
						}
					}
				});
				
				// Calculate monthly variation chart
				if(variationChartData && variationChartData[0].data && variationChartData[0].data.length > 0) {
					// Aggregate variations by month
					const monthlyData = {};
					const currentYear = new Date().getFullYear();
					
					// Initialize all 12 months with 0
					for(let month = 0; month < 12; month++) {
						const monthKey = currentYear + '-' + String(month + 1).padStart(2, '0');
						monthlyData[monthKey] = 0;
					}
					
					// Aggregate variations by month
					variationChartData[0].data.forEach(point => {
						if(point.t && point.y !== undefined && point.y !== null) {
							const date = new Date(point.t);
							const year = date.getFullYear();
							const month = date.getMonth() + 1; // 1-12
							
							// Only include current year data
							if(year === currentYear) {
								const monthKey = year + '-' + String(month).padStart(2, '0');
								if(monthlyData[monthKey] !== undefined) {
									monthlyData[monthKey] += Number(point.y) || 0;
								}
							}
						}
					});
					
					// Convert to array format for chart
					const monthlyChartData = [];
					const monthNames = ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'];
					
					for(let month = 1; month <= 12; month++) {
						const monthKey = currentYear + '-' + String(month).padStart(2, '0');
						const monthValue = monthlyData[monthKey] || 0;
						monthlyChartData.push({
							t: new Date(currentYear, month - 1, 1).toISOString(),
							y: monthValue
						});
					}
					
					// Display monthly variation chart
					if(monthlyChartData.length > 0) {
