				// Fallback: Calculate variation chart from the main chart data
				// Find the main dataset (first dataset with "Nombre" or "dans OSM" or "objets" in label, excluding the start date line)
				const mainDataset = res.chart.find(
					(ds) =>
						ds &&
						typeof ds.label === "string" &&
						(ds.label.toLowerCase().includes("nombre") || 
						 ds.label.toLowerCase().includes("dans osm") || 
						 ds.label.toLowerCase().includes("objets")) &&
						!ds.label.includes('#{__("Début du projet")}')
				);
				
				if(mainDataset && Array.isArray(mainDataset.data) && mainDataset.data.length > 1) {
					// Calculate variations: for each point i (starting from i=1), variation[i] = value[i] - value[i-1]
					const variationData = [];
					for (let i = 1; i < mainDataset.data.length; i++) {
						const prev = mainDataset.data[i - 1];
						const curr = mainDataset.data[i];
						const variation = (Number(curr.y) || 0) - (Number(prev.y) || 0);
						variationData.push({
							t: curr.t,
							y: variation
						});
