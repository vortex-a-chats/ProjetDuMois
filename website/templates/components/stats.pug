			div.modal-body
				div
					h6= __("Temps estimé (ETA)")
					p= __("Le temps estimé pour compléter les objets restants est calculé en divisant le nombre d'objets restants par le taux d'ajout quotidien moyen.")
					ul
						li= __("Le taux quotidien est calculé à partir des ajouts sur les 6 derniers mois (priorité), ou sur 30 jours, 7 jours, ou 12 mois selon les données disponibles.")
						li= __("Formule : ETA (jours) = Objets restants ÷ Taux quotidien moyen")
						li= __("Pour les tâches Osmose \"à ajouter\", l'estimation est basée uniquement sur les 6 derniers mois de progression.")
					
					h6.mt-4= __("Objets restants")
					p= __("Le nombre d'objets restants est calculé à partir de l'objectif défini dans la configuration du projet (statistics.total_expected, statistics.to_integrate ou statistics.target).")
					ul
						li= __("Formule : Objets restants = Objectif total - Nombre actuel d'objets dans OSM")
					
					h6.mt-4= __("Objets restants par personne")
					p= __("Cette statistique répartit le travail restant entre tous les contributeurs.")
					ul
						li= __("Formule : Restant par personne = Objets restants ÷ Nombre de contributeurs")
					
					h6.mt-4= __("Contributeurs par commune")
					p= __("Cette statistique donne une idée de la répartition géographique des contributeurs.")
					ul
						li= __("Formule : Contributeurs par commune = Nombre de contributeurs ÷ 34 874 (nombre de communes en France)")
						li= __("Cette estimation est basée sur le nombre total de communes INSEE en France.")
					
					h6.mt-4= __("Objets intégrés par commune")
					p= __("Cette statistique donne une idée de la répartition géographique des objets cartographiés.")
					ul
						li= __("Formule : Objets par commune = Nombre total d'objets ÷ 34 874 (nombre de communes en France)")
					
					h6.mt-4= __("Ajouts sur différentes périodes")
					p= __("Les statistiques d'ajouts sont calculées en comparant le nombre d'objets à deux dates différentes :")
					ul
						li= __("7 jours : différence entre aujourd'hui et il y a 7 jours")
						li= __("30 jours : différence entre aujourd'hui et il y a 30 jours")
						li= __("6 mois (180 jours) : différence entre aujourd'hui et il y a 180 jours")
						li= __("12 mois (365 jours) : différence entre aujourd'hui et il y a 365 jours")
					
					h6.mt-4= __("Note importante")
					p.text-muted.small= __("Ces estimations sont basées sur les données historiques et peuvent varier selon l'activité future des contributeurs. Elles servent d'indicateur et non de prédiction exacte.")

