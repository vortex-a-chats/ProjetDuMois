            {"v": "permissive", "l": "Avec permission"}
          ]
        },
        {
          "type": "text",
          "name": "Nom",
          "tag": "name",
          "optional": true
        },
        {
          "type": "text",
          "name": "Opérateur",
          "tag": "operator",
          "optional": true,
          "description": "Gestionnaire (commune, association, etc.)"
        },
        {
          "type": "textarea",
          "name": "Autres informations",
          "tag": "note",
          "optional": true
        }
      ],
      "title": {
        "add": "Ajouter un parc pour enfants manquant",
        "edit": "Compléter ce parc pour enfants"
      }
