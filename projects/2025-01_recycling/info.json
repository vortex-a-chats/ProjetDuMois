  },
  "quality": {
    "required_tags": [
      "recycling_type"
    ]
  },
  "database": {
    "osmium_tag_filter": "amenity=recycling",
    "imposm": {
      "types": ["point", "polygon"],
      "mapping": {
        "amenity": ["recycling"]
      }
    }
  },
  "datasources": [
