      "hashtags": "projetdumois,projetdumoisfr,recycling"
    },
    "pdm": {
      "fields": [
        {
          "type": "hidden",
          "tags": {
            "amenity": "recycling",
            "source": "*"
          }
        },
        {
          "type": "select",
          "name": "Type de recyclage",
          "tag": "recycling_type",
          "optional": false,
          "values": [
            {"v": "glass", "l": "Verre"},
            {"v": "paper", "l": "Papier"},
            {"v": "plastic", "l": "Plastique"},
            {"v": "metal", "l": "Métal"},
            {"v": "clothes", "l": "Vêtements"},
            {"v": "batteries", "l": "Piles"},
            {"v": "electronics", "l": "Électronique"},
            {"v": "oil", "l": "Huile"},
            {"v": "organic", "l": "Organique"}
          ],
          "description": "Type de matériaux acceptés (peut être une liste séparée par des points-virgules)"
        },
        {
          "type": "text",
          "name": "Nom",
          "tag": "name",
          "optional": true,
          "description": "Nom du point d'apport volontaire si disponible"
        },
        {
          "type": "text",
          "name": "Opérateur",
          "tag": "operator",
          "optional": true,
          "description": "Nom de l'opérateur (commune, entreprise, etc.)"
        },
        {
          "type": "textarea",
          "name": "Autres informations",
          "tag": "note",
          "optional": true
        }
      ],
      "title": {
        "add": "Ajouter un point d'apport volontaire manquant",
        "edit": "Compléter ce point d'apport volontaire"
      }
