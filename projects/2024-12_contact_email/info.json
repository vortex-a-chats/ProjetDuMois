{
  "id": "2024-12_contact_email",
  "title": "Lieux avec email",
  "start_date": "2018-12-01",
  "end_date": "2026-06-01",
  "summary": "Les lieux avec une adresse email sont plus facilement contactables. Complétons les informations de contact dans OpenStreetMap ! #ContactEmail #ProjetDuMois",
